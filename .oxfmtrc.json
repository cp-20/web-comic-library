{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [".next/**", "coverage/**", "dist/**", "node_modules/**"],
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": true,
  "singleQuote": true,
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  },
  "trailingComma": "all"
}

{
  "name": "web-comic-library",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "benchmark:api": "bun run --cwd apps/api benchmark",
    "build:web": "bun run --cwd apps/web build",
    "check": "bun run fmt:check && bun run lint && bun run typecheck",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "issues": "bun run tools/issues/main.ts",
    "issues:cli": "bun run tools/issues/cli/main.ts",
    "lint": "oxlint . --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix",
    "monitor:uptime": "bun run scripts/uptime-monitor.ts",
    "smoke:compatibility": "bun run --cwd apps/worker smoke",
    "test": "bun test apps packages scripts tools",
    "test:e2e": "playwright test",
    "test:integration": "ALLOW_DATABASE_INTEGRATION_TESTS=1 DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/web_comic_library bun test",
    "typecheck": "bun run --filter '*' typecheck && tsc -p tools/issues/tsconfig.json",
    "verify:compatibility": "bun test && bun run smoke:compatibility"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/bun": "1.3.14",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7"
  },
  "packageManager": "bun@1.3.14"
}
